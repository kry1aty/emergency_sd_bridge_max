# ==============================================================================
# НАСТРОЙКИ АВАРИЙНОГО МОСТА MAX <-> TELEGRAM
# Скопируйте этот файл как .env в эту же папку и заполните 3 значения ниже:
# ==============================================================================

# 1. Токен бота MAX (из личного кабинета бота MAX или боевого .env)
MAX_BOT_TOKEN=

# 2. Токен Telegram-бота (полученный в Telegram у @BotFather)
TELEGRAM_BOT_TOKEN=

# 3. ID чата/группы операторов в Telegram
# - Если это личный чат с ботом: ваш личный ID (число, например: 123456789)
# - Если это группа операторов: ID супергруппы (отрицательное число, например: -1001234567890)
# Узнать свой ID или ID группы можно переслав сообщение боту @userinfobot
TELEGRAM_OPERATOR_CHAT_ID=

# 4. Режим персональных топиков (тредов) для каждого клиента: true / false
# Если в супергруппе включены темы (Topics) — бот сам создает персональную ветку для каждого клиента.
USE_FORUM_TOPICS=true

# Базовый URL API MAX (по умолчанию https://botapi.max.ru)
MAX_API_BASE_URL=https://botapi.max.ru

# ==============================================================================
# РЕЖИМ ТРАНСПОРТА: polling (по умолчанию) или webhook
# ==============================================================================
# Режим polling — не требует открытых портов, белых IP и SSL. Бот сам опрашивает API.
# При выборе polling мост автоматически очистит любые старые вебхуки.
TRANSPORT_MODE=polling

# Настройки для режима webhook (актуальны только при TRANSPORT_MODE=webhook):
# Публичный базовый HTTPS URL вашего приложения на хостинге (без слэша на конце)
WEBHOOK_BASE_URL=
# Порт для входящих HTTP-запросов (Bothost/хостинги обычно передают порт через переменную PORT)
WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0
